#version 450
// Reproject unjittered current clip coordinates into the previous camera, in render pixels.
// View distance is stored separately for model visibility and does not affect camera vectors.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1, rg16f) uniform writeonly image2D mv_out;
layout(binding = 2, std140, row_major) uniform Reprojection { mat4 clip_to_prev; } reprojection;
layout(binding = 3, r32f) uniform writeonly image2D depth_out;
layout(push_constant) uniform P {
    vec2 size;
    vec2 jitter;
    vec4 dz; // depth terms of the projection matrix
    uint write_distance;
    uint camera_mv;
} pc;

float view_distance(float zn) {
    float den = pc.dz.z * zn - pc.dz.x;
    if (abs(den) < 1e-12) return 0.0;
    float z = abs((pc.dz.y - pc.dz.w * zn) / den);
    return z < 1e7 ? z : 0.0;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.size)))) return;
    float zn = texelFetch(depth_tex, p, 0).r * 2.0 - 1.0;
    if (pc.write_distance != 0u) imageStore(depth_out, p, vec4(view_distance(zn)));

    vec2 mv = vec2(0.0);
    if (pc.camera_mv != 0u) {
        vec2 win = vec2(p) + 0.5 - pc.jitter;
        vec2 ndc = win / pc.size * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
        vec4 previous = reprojection.clip_to_prev * vec4(ndc, zn, 1.0);
        if (previous.w > 0.0) {
            vec2 delta = (previous.xy / previous.w - ndc) * vec2(0.5, -0.5) * pc.size;
            if (!any(isnan(delta)) && !any(isinf(delta)))
                mv = clamp(delta, vec2(-65504.0), vec2(65504.0));
        }
    }
    imageStore(mv_out, p, vec4(mv, 0.0, 0.0));
}
